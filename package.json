    "test:mail": "node server/.t/test-mail.mjs",
    "test:emailcode": "node server/.t/test-emailcode.mjs",
    "test:datadir": "node server/.t/test-datadir.mjs",
    "test:lifecycle": "node server/.t/test-lifecycle.mjs",
